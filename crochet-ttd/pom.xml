<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>edu.neu.ccs.prl.crochet</groupId>
        <artifactId>crochet-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>crochet-ttd</artifactId>
    <packaging>jar</packaging>

    <description>
        Time-travel debugger primitive built on Crochet's checkpoint/rollback.
        Phase 0: programmatic Ttd.breakpoint() in user code.
        Phase 1: @TimeTravelBody annotation + javaagent that auto-instruments
        each source line as an implicit pause point. Single-threaded;
        deterministic body required (no currentTimeMillis, Random, IO).
    </description>

    <dependencies>
        <dependency>
            <groupId>edu.neu.ccs.prl.crochet</groupId>
            <artifactId>crochet-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <!-- asm-tree + asm-analysis: used by LivenessAnalyzer (B.1) -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-analysis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>edu.neu.ccs.prl.crochet.ttd.TtdAgent</Premain-Class>
                            <Agent-Class>edu.neu.ccs.prl.crochet.ttd.TtdAgent</Agent-Class>
                            <Can-Redefine-Classes>true</Can-Redefine-Classes>
                            <Can-Retransform-Classes>true</Can-Retransform-Classes>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>org.objectweb.asm</pattern>
                                    <shadedPattern>edu.neu.ccs.prl.crochet.ttd.shaded.asm</shadedPattern>
                                </relocation>
                            </relocations>
                            <artifactSet>
                                <includes>
                                    <include>org.ow2.asm:*</include>
                                </includes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!--
                      Default execution: all tests EXCEPT CorpusLivenessTest, under both
                      javaagents and -Xverify:all. CorpusLivenessTest is excluded here
                      because it creates ASM ClassNode objects that Crochet's field-access
                      wrapper wraps with $$crochetAccess() calls; when other test classes
                      loaded ASM's ClassNode before the Crochet agent fully processed it
                      (class-load ordering is non-deterministic under -Xverify:all), the
                      wrapper call fails with NoSuchMethodError. The test itself exercises
                      only LivenessAnalyzer (pure analysis, no TTD runtime), so running it
                      without the javaagents in the corpus execution below is correct.
                    -->
                    <execution>
                        <id>default-test</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <excludes>
                                <exclude>**/cps/CorpusLivenessTest.java</exclude>
                            </excludes>
                            <argLine>-Xverify:all -javaagent:${project.basedir}/target/crochet-ttd-${project.version}.jar -javaagent:${project.basedir}/../crochet-agent/target/crochet-agent-${project.version}.jar --add-reads java.base=jdk.unsupported</argLine>
                        </configuration>
                    </execution>
                    <!--
                      Corpus execution: CorpusLivenessTest only, in its own forked JVM
                      without the javaagents. The test reads JDK class files and runs
                      LivenessAnalyzer — no TTD or Crochet runtime is needed. Running it
                      in isolation avoids the ASM ClassNode instrumentation ordering issue
                      described above.
                    -->
                    <execution>
                        <id>corpus-test</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <includes>
                                <include>**/cps/CorpusLivenessTest.java</include>
                            </includes>
                            <argLine>-Xverify:all</argLine>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
