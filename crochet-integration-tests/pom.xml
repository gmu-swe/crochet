<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>edu.neu.ccs.prl.crochet</groupId>
        <artifactId>crochet-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>crochet-integration-tests</artifactId>
    <packaging>jar</packaging>

    <description>End-to-end integration tests that run against a Crochet-instrumented JDK produced by the Maven plugin.</description>

    <properties>
        <!-- Path to the instrumented JDK image. Defaults to the running JAVA_HOME
             so CI works without a pre-built instrumented JDK. Override with:
             -DjdkInst=/path/to/instrumented-jdk -->
        <jdkInst>${env.JAVA_HOME}</jdkInst>
        <!-- Path to the crochet-agent shaded jar. Defaults to the local
             Maven repository install from the current build. -->
        <crochetAgentJar>${settings.localRepository}/edu/neu/ccs/prl/crochet/crochet-agent/${project.version}/crochet-agent-${project.version}.jar</crochetAgentJar>
        <!-- Integration tests exercise Java 21 APIs (virtual threads, sealed types).
             The crochet-agent module compiles to Java 17 (source/target only, not
             release), but the IT module must target Java 21 to reference
             Thread.ofVirtual() and pattern-match on sealed CheckpointEvent subtypes. -->
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>edu.neu.ccs.prl.crochet</groupId>
            <artifactId>crochet-agent</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- Run ITs under the instrumented JDK. -->
                    <jvm>${jdkInst}/bin/java</jvm>
                    <argLine>
                        --add-reads java.base=jdk.unsupported
                        -javaagent:${crochetAgentJar}
                        --add-exports java.base/jdk.internal.vm=ALL-UNNAMED
                        --add-opens java.base/jdk.internal.vm=ALL-UNNAMED
                    </argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
