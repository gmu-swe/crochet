<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>edu.neu.ccs.prl.crochet</groupId>
        <artifactId>crochet-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>crochet-agent</artifactId>
    <packaging>jar</packaging>

    <description>Runtime Java agent and supporting runtime classes; packed into java.base by the jlink pipeline.</description>

    <dependencies>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <properties>
        <!-- FastAccessCoordinator uses @jdk.internal.vm.annotation.Contended
             for stripe-lock padding. That package is not exported by
             java.base by default; expose it at compile time. The runtime is
             packed into java.base by the jlink pipeline and the @Contended
             annotation has RetentionPolicy.CLASS, so no runtime flag is
             required on the instrumented JDK (and for the -javaagent path
             the annotation has no observable effect; only HotSpot's layout
             reader honors it when the class is in java.base). -->
        <maven.compiler.release></maven.compiler.release>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- proc=none prevents javac from loading our own APT
                         (CrochetCheckpointProcessor) during self-compilation —
                         the processor class hasn't been compiled yet at that
                         point, so javac would fail with "Provider not found".
                         Downstream projects that want compile-time validation
                         should add crochet-agent as an annotation-processor
                         dependency without this override. -->
                    <proc>none</proc>
                    <compilerArgs>
                        <arg>--add-exports</arg>
                        <arg>java.base/jdk.internal.vm.annotation=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Premain-Class>net.jonbell.crochet.agent.CrochetAgent</Premain-Class>
                            <Agent-Class>net.jonbell.crochet.agent.CrochetAgent</Agent-Class>
                            <Can-Redefine-Classes>true</Can-Redefine-Classes>
                            <Can-Retransform-Classes>true</Can-Retransform-Classes>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.ow2.asm:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.objectweb.asm</pattern>
                                    <shadedPattern>edu.neu.ccs.prl.crochet.agent.shaded.asm</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
